<?xml version="1.0" encoding="UTF-8"?>
<!-- Thème « Xcode » (sombre) : couleurs du thème sombre par défaut d'Xcode. -->
<style-scheme id="lcode-xcode-dark" name="Xcode sombre" version="1.0">
  <author>LCode</author>
  <description>Couleurs d'Xcode (sombre)</description>
  <style name="text" foreground="#FFFFFF" background="#1F1F24"/>
  <style name="selection" background="#515B70"/>
  <style name="current-line" background="#23252B"/>
  <style name="line-numbers" foreground="#747478" background="#1F1F24"/>
  <style name="current-line-number" foreground="#FFFFFF" background="#23252B"/>
  <style name="bracket-match" background="#5E5427"/>
  <style name="cursor" foreground="#FFFFFF"/>
  <style name="def:keyword" foreground="#FC5FA3" bold="true"/>
  <style name="def:builtin" foreground="#FC5FA3" bold="true"/>
  <style name="def:type" foreground="#5DD8FF"/>
  <style name="def:string" foreground="#FC6A5D"/>
  <style name="def:special-char" foreground="#FC6A5D"/>
  <style name="def:number" foreground="#D0BF69"/>
  <style name="def:floating-point" foreground="#D0BF69"/>
  <style name="def:boolean" foreground="#FC5FA3" bold="true"/>
  <style name="def:comment" foreground="#6C7986" italic="true"/>
  <style name="def:doc-comment" foreground="#6C7986" italic="true"/>
  <style name="def:preprocessor" foreground="#FD8F3F"/>
  <style name="def:identifier" foreground="#FFFFFF"/>
  <style name="def:function" foreground="#67B7A4"/>
  <style name="def:operator" foreground="#FFFFFF"/>
  <style name="def:decimal" foreground="#D0BF69"/>
  <style name="def:special-constant" foreground="#FC5FA3" bold="true"/>
  <style name="swift:declaration" foreground="#FC5FA3" bold="true"/>
  <style name="swift:modifier" foreground="#FC5FA3" bold="true"/>
  <style name="swift:type" foreground="#5DD8FF"/>
  <style name="swift:special" foreground="#FD8F3F"/>
</style-scheme>
