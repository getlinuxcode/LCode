<?xml version="1.0" encoding="UTF-8"?>
<!-- Xcode default theme colors (light). -->
<style-scheme id="lcode-xcode" name="Xcode" version="1.0">
  <author>LCode</author>
  <description>Xcode colors (light)</description>
  <style name="text" foreground="#000000" background="#FFFFFF"/>
  <style name="selection" background="#B4D8FD"/>
  <style name="current-line" background="#ECF5FF"/>
  <style name="line-numbers" foreground="#A6A6A6" background="#FFFFFF"/>
  <style name="current-line-number" foreground="#000000" background="#ECF5FF"/>
  <style name="bracket-match" background="#FEF59B"/>
  <style name="cursor" foreground="#000000"/>
  <style name="def:keyword" foreground="#9B2393" bold="true"/>
  <style name="def:builtin" foreground="#9B2393" bold="true"/>
  <style name="def:type" foreground="#3900A0"/>
  <style name="def:string" foreground="#C41A16"/>
  <style name="def:special-char" foreground="#C41A16"/>
  <style name="def:number" foreground="#1C00CF"/>
  <style name="def:floating-point" foreground="#1C00CF"/>
  <style name="def:boolean" foreground="#9B2393" bold="true"/>
  <style name="def:comment" foreground="#5D6C79" italic="true"/>
  <style name="def:doc-comment" foreground="#5D6C79" italic="true"/>
  <style name="def:preprocessor" foreground="#643820"/>
  <style name="def:identifier" foreground="#000000"/>
  <style name="def:function" foreground="#326D74"/>
  <style name="def:operator" foreground="#000000"/>
  <style name="def:decimal" foreground="#1C00CF"/>
  <style name="def:special-constant" foreground="#9B2393" bold="true"/>
  <style name="swift:declaration" foreground="#9B2393" bold="true"/>
  <style name="swift:modifier" foreground="#9B2393" bold="true"/>
  <style name="swift:type" foreground="#3900A0"/>
  <style name="swift:special" foreground="#815F03"/>
</style-scheme>
